{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true,
    "baseUrl": ".", "paths": {
      "@clawdle/game": ["packages/game/src/index.ts"],
      "@clawdle/app-core": ["packages/app-core/src/index.ts"],
      "@clawdle/ui": ["packages/ui/src/index.ts"],
      "@clawdle/platform-web": ["packages/platform-web/src/index.ts"],
      "@clawdle/platform-desktop": ["packages/platform-desktop/src/index.ts"],
      "@clawdle/contracts": ["packages/contracts/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", ".worktrees", ".tools", "target", "dist"]
}
